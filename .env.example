# Copia este archivo como frontend/.env.local para desarrollo local.
# En Vercel: Project Settings -> Environment Variables (mismos nombres).

# --- Firebase Admin (servidor / backend) ---
# Firebase Console -> Project settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com
# Pega la llave entre comillas, con los \n tal cual vienen en el JSON
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Stripe (Dashboard > Developers > API keys). Usar claves test_ en local y preview; live_ solo en produccion.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
# Webhook hacia /api/stripe/webhook (eventos checkout.session.completed y checkout.session.expired)
STRIPE_WEBHOOK_SECRET=whsec_...

# Contrasena del panel /admin (minimo 8 caracteres; usar una larga y unica)
ADMIN_PASSWORD=

# Correos (Resend): avisos de reservas y recuperar contrasena. El dominio del remitente debe estar verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM="The Bot Spot <bookings@thebotspot.org>"
# Opcional: clave para firmar sesiones de clientes (si falta se deriva de FIREBASE_PRIVATE_KEY)
SESSION_SECRET=
